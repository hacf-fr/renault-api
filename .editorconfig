root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 2

[*.{py,toml}]
indent_size = 4

[*.rst]
# reStructuredText directives use 3-space indentation
indent_size = unset

[*.md]
trim_trailing_whitespace = false

[*.ambr]
# syrupy snapshots are generated; keep them byte-for-byte
trim_trailing_whitespace = false
